---
import '../styles/global.css';
import '../styles/site-chrome.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Wenjin Tao - Staff Product Manager bridging Automation, Robotics, and AI to build the next generation of manufacturing.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const ogImage = new URL('/og-home.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!-- Static pages can't read ?embed at build time, so detect the embedded /
         iframe context at runtime (before paint) and hide the site chrome. -->
    <script is:inline>
      if (window.self !== window.top || new URLSearchParams(location.search).get('embed') === '1') {
        document.documentElement.classList.add('is-embedded');
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Wenjin Tao" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="site min-h-screen flex flex-col">
    <!-- the homepage's header and footer (the old Navbar / Footer components are no longer used) -->
    <header class="site-head">
      <a class="wordmark" href="/">WENJIN&nbsp;TAO<span class="dot">.</span></a>
      <nav aria-label="Sections">
        <a href="/#labs">LABS</a>
        <a href="/#now">NOW</a>
        <a href="/#work" aria-current={path.startsWith('/projects') ? 'page' : undefined}>WORK</a>
        <a href="/publications" aria-current={path.startsWith('/publications') ? 'page' : undefined}>RESEARCH</a>
        <a href="/blog" aria-current={path.startsWith('/blog') ? 'page' : undefined}>BLOG</a>
      </nav>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="site-foot">
      <nav aria-label="More">
        <a href="https://www.linkedin.com/in/wenjin-tao" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="https://github.com/WenjinTao" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="/classic">Classic site</a>
      </nav>
      <span>© Wenjin Tao</span>
    </footer>
  </body>
</html>
