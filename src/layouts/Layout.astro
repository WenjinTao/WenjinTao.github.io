---
import '../styles/global.css';
import '../styles/site-chrome.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Wenjin Tao - Staff Product Manager bridging Automation, Robotics, and AI to build the next generation of manufacturing.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const ogImage = new URL('/og-home.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // theme before paint: light by default, dark if chosen (remembered)
      try {
        document.documentElement.dataset.theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
        document.documentElement.dataset.accent = localStorage.getItem('accent') || 'teal';
      } catch (e) { document.documentElement.dataset.theme = 'light'; }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!-- Static pages can't read ?embed at build time, so detect the embedded /
         iframe context at runtime (before paint) and hide the site chrome. -->
    <script is:inline>
      if (window.self !== window.top || new URLSearchParams(location.search).get('embed') === '1') {
        document.documentElement.classList.add('is-embedded');
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Wenjin Tao" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="site min-h-screen flex flex-col">
    <!-- the homepage's header and footer (the old Navbar / Footer components are no longer used) -->
    <header class="site-head">
      <a class="wordmark" href="/">WENJIN&nbsp;TAO<span class="dot">.</span></a>
      <nav aria-label="Sections">
        <a href="/#labs">LABS</a>
        <a href="/#lately">LATELY</a>
        <a href="/#work" aria-current={path.startsWith('/projects') ? 'page' : undefined}>WORK</a>
        <a href="/publications" aria-current={path.startsWith('/publications') ? 'page' : undefined}>RESEARCH</a>
        <button class="accent-toggle" type="button" aria-label="Change the accent colour" title="Accent colour"><span></span></button><button class="theme-toggle" type="button" aria-label="Switch between light and dark"><svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></button>
      </nav>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="site-foot">
      <nav aria-label="More">
        <a href="https://www.linkedin.com/in/wenjin-tao" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="https://github.com/WenjinTao" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="/classic">Classic site</a>
      </nav>
      <span>© Wenjin Tao</span>
    </footer>
    <script is:inline>
      const ACCENTS = ['teal', 'green', 'persimmon', 'indigo'];
      document.querySelectorAll('.accent-toggle').forEach((b) => b.addEventListener('click', () => {
        const cur = document.documentElement.dataset.accent || 'teal';
        const next = ACCENTS[(ACCENTS.indexOf(cur) + 1) % ACCENTS.length];
        document.documentElement.dataset.accent = next;
        try { localStorage.setItem('accent', next); } catch (e) {}
      }));
      document.querySelectorAll('.theme-toggle').forEach((b) => b.addEventListener('click', () => {
        const t = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
        try { localStorage.setItem('theme', t); } catch (e) {}
        dispatchEvent(new CustomEvent('themechange', { detail: t }));
      }));
    </script>
  </body>
</html>
