---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} | Wenjin Tao`}>
  <article class="page-top pb-24">
    <div class="section-container max-w-3xl">
      <a href="/#work" class="text-cyan-400 text-sm hover:underline mb-6 inline-block">&larr; Selected work</a>

      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">{project.data.title}</h1>
      <p class="text-lg text-gray-400 mb-6">{project.data.description}</p>

      <div class="flex flex-wrap gap-1.5 mb-8">
        {project.data.tags.map((tag: string) => (
          <span class="rounded-full border border-cyan-300/15 bg-cyan-300/[0.05] px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-cyan-100/70">
            {tag}
          </span>
        ))}
      </div>

      <div class="glow-line mb-8"></div>

      <div class="prose prose-invert max-w-none
        prose-headings:font-semibold prose-headings:text-white prose-headings:tracking-tight
        prose-h2:text-lg prose-h2:mt-8 prose-h2:mb-3 prose-h2:first:mt-0
        prose-h3:text-base prose-h3:mt-6 prose-h3:mb-2
        prose-p:text-gray-300 prose-p:leading-relaxed
        prose-ul:my-3 prose-li:my-1.5 prose-li:text-gray-300 prose-li:marker:text-cyan-400
        prose-strong:text-white prose-strong:font-semibold
        prose-a:text-cyan-400 prose-a:no-underline hover:prose-a:underline">
        <Content />
      </div>
    </div>
  </article>
</Layout>
