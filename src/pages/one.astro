---
// One-screen homepage (concept): the homepage's sections side by side in one screen: intro + Latest | Labs |
// Publications + Projects. A row opens a detail panel in place (no page change). Phones: three tabs that swipe.
// (The first take, three columns Bits | Tokens | Atoms, is in git: f83ca32.)
// Same content as the full homepage ("/"): labs, the build-in-public work (src/data/now.json), the earlier
// projects (content collection + photos) and the publications.
import '../styles/one.css';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import NOW from '../data/now.json';

type Link = { title: string; href: string };
type Item = { id: string; title: string; sub: string; thumb: string | null; text: string; play?: string; page?: string;
  links?: Link[]; days?: { date: string; day: string; title: string; href: string }[]; pubs?: Link[] };

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*-1.jpg', { eager: true });
const projects = new Map((await getCollection('projects')).map((p) => [p.id, p]));
async function project(id: string, sub: string): Promise<Item> {
  const p = projects.get(id)!;
  const ph = photos[`../assets/projects/${id}-1.jpg`]?.default;
  return { id, title: p.data.title.split(':')[0], sub, text: p.data.description,
    thumb: ph ? (await getImage({ src: ph, width: 640 })).src : null };
}
const now = (title: string, id: string): Item => {
  const n = NOW.find((x) => x.title.startsWith(title))!;
  return { id, title: n.title, sub: n.tag, text: n.text, thumb: n.shot, links: n.links, days: n.days };
};
const SCHOLAR = 'https://scholar.google.com/citations?user=jIQocKAAAAAJ&hl=en';
const pubs = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);

const LABS: Item[] = [
  { id: 'banana', title: 'Banana Boolean', sub: 'WebAssembly', thumb: '/labs/thumbs/banana-boolean.jpg', play: '/labs/banana-boolean/',
    text: 'Swipe to slice a banana. Every cut is an exact Boolean from my own C++ geometry kernel, running in your browser, with physics, browning and combos.' },
  { id: 'leaves', title: 'SimReady Leaves', sub: 'Isaac Sim', thumb: '/labs/thumbs/simready-leaves.jpg', play: '/labs/simready-leaves/',
    text: '56 leaves of 28 tree species, turned from herbarium scans into simulation-ready assets. Flip one to see its mesh, collider and mass, then watch all of them fall in an Isaac Sim replay.' },
];
// CAD 101: links for L3-L7 are not in post-log.md yet -> the profile's activity page until they are.
const FEED = 'https://www.linkedin.com/in/wenjin-tao/recent-activity/all/';
const post = (id: string) => `https://www.linkedin.com/feed/update/urn:li:activity:${id}/`;
const CAD101: Item = { id: 'cad101', title: 'CAD 101', sub: 'Lessons 1–7', thumb: '/home/now/cad101.jpg',
  text: 'Short visual lessons on how CAD works under the hood: freeform surfaces, G0–G3 continuity, topology optimization, TPMS lattices and Boolean operations, each a 30–40 s film made from real geometry.',
  days: [
    { date: '11/05', day: 'L1', title: 'From a point to a freeform surface', href: post('7524327657862324224') },
    { date: '11/06', day: 'L2', title: 'How curves meet (G0–G3)', href: post('7524606828048154624') },
    { date: '', day: 'L3', title: 'How surfaces meet', href: FEED },
    { date: '', day: 'L4', title: 'How material finds its shape', href: FEED },
    { date: '', day: 'L5', title: 'Topology optimization: SIMP, BESO, level set, MMC', href: FEED },
    { date: '', day: 'L6', title: 'TPMS lattices', href: FEED },
    { date: '', day: 'L7', title: 'Boolean operations', href: FEED },
  ],
  links: [{ title: 'Issue 1: AI on surface modeling', href: post('7523608072913661952') }] };
const NOW_ITEMS: Item[] = [CAD101, now('Isaac Factory', 'factory'), now('SoundReady', 'soundready'), now('Surface Checker', 'surface'),
  now('Therbligs', 'therbligs')];
const WORK_ORDER: [string, string][] = [['optimo', 'AI × Manufacturing'], ['folo', 'AI × Manufacturing'],
  ['pin-defect-detection', 'Vision AI'], ['mask-defect-detection', 'Vision AI'],
  ['field-robotics', 'Robotics & Hardware'], ['low-cost-ventilator', 'Robotics & Hardware']];
const WORK: Item[] = await Promise.all(WORK_ORDER.map(([id, label]) => project(id, label)));
const RESEARCH = pubs.slice(0, 4).map((p) => ({ year: p.data.year, title: p.data.title,
  href: p.data.link ?? (p.data.doi ? `https://doi.org/${p.data.doi}` : SCHOLAR) }));
const DATA = Object.fromEntries([...LABS, ...NOW_ITEMS, ...WORK].map((i) => [i.id, i]));

const title = 'Wenjin Tao — Bits to Atoms, Faster';
const description = 'Wenjin Tao — Staff Product Manager, Physical AI. Simulation, AI and manufacturing, built in public.';
const canonical = new URL('/one', Astro.site).href;
const ogImage = new URL('/og-home.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
        document.documentElement.dataset.accent = localStorage.getItem('accent') || 'teal';
      } catch (e) { document.documentElement.dataset.theme = 'light'; }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="shell">
      <header>
        <a class="wordmark" href="/">WENJIN&nbsp;TAO<span class="dot">.</span></a>
        <div class="controls">
          <a class="full" href="/">Full page</a>
          <button class="accent-toggle" type="button" aria-label="Change the accent colour" title="Accent colour"><span></span></button>
          <button class="theme-toggle" type="button" aria-label="Switch between light and dark">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
          </button>
        </div>
      </header>

      <nav class="tabs" aria-label="Sections">
        {['Latest', 'Labs', 'Work'].map((t, i) => <button type="button" data-col={i}>{t}</button>)}
      </nav>

      <main class="cols">
        <section class="col col-intro" aria-label="Latest">
          <div class="intro">
            <h1>Bits to Atoms, <span class="tokens-word">Faster</span></h1>
            <p class="tagline">Experiments in robotics, simulation, AI for engineering, and anything else I&rsquo;m curious about.</p>
          </div>
          <h2 class="mod">Latest <span>building in public</span></h2>
          <ul class="rows fill">
            {NOW_ITEMS.map((it) => (
                <li>
                  <button type="button" class="item big" data-id={it.id}>
                    {it.thumb && <img src={it.thumb} alt="" width="160" height="100" loading="lazy" />}
                    <span class="t"><span class="title">{it.title}</span><span class="sub">{it.sub}</span>
                      <span class="blurb">{it.text}</span></span>
                  </button>
                </li>
            ))}
          </ul>
        </section>

        <section class="col col-labs" aria-label="Labs">
          <h2 class="mod">Labs <span>play in the browser</span></h2>
          <ul class="labs">
            {LABS.map((it) => (
              <li>
                <button type="button" class="lab" data-id={it.id}>
                  <span class="lab-media"><img src={it.thumb!} alt="" width="960" height="540" loading="lazy" />
                    {it.id === 'leaves' && <canvas id="field" data-card aria-hidden="true"></canvas>}</span>
                  <span class="lab-t"><span class="title">{it.title}</span><span class="play">PLAY</span></span>
                  <span class="sub">{it.sub}</span>
                </button>
              </li>
            ))}
          </ul>
        </section>

        <section class="col col-work" aria-label="Publications and projects">
          <h2 class="mod">Publications <span>{pubs.length} papers</span></h2>
          <ul class="pubs">
            {RESEARCH.map((r) => (
              <li><a href={r.href} target="_blank" rel="noopener"><b>{r.year}</b> {r.title}</a></li>
            ))}
          </ul>
          <a class="more" href={SCHOLAR} target="_blank" rel="noopener">All publications on Google Scholar ↗</a>
          <h2 class="mod mod-work">Projects <span>industry &amp; research</span></h2>
          <ul class="rows compact fill">
            {WORK.map((it) => (
                <li>
                  <button type="button" class="item" data-id={it.id}>
                    {it.thumb && <img src={it.thumb} alt="" width="96" height="60" loading="lazy" />}
                    <span class="t"><span class="title">{it.title}</span><span class="sub">{it.sub}</span></span>
                  </button>
                </li>
            ))}
          </ul>
        </section>
      </main>

      <footer>
        <p><strong>Wenjin Tao</strong> — Staff Product Manager, Physical AI · San Francisco Bay Area</p>
        <nav aria-label="Profiles">
          <a href="https://www.linkedin.com/in/wenjin-tao" target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href="https://github.com/WenjinTao" target="_blank" rel="noopener">GitHub ↗</a>
          <a href={SCHOLAR} target="_blank" rel="noopener">Scholar ↗</a>
        </nav>
      </footer>
    </div>

    <dialog id="detail" aria-labelledby="d-title">
      <button class="close" type="button" aria-label="Close">×</button>
      <img id="d-img" alt="" />
      <div class="d-body">
        <p class="d-sub" id="d-sub"></p>
        <h3 id="d-title"></h3>
        <p id="d-text"></p>
        <ol id="d-days" class="d-days"></ol>
        <ul id="d-links" class="d-links"></ul>
        <div class="d-actions" id="d-actions"></div>
      </div>
    </dialog>

    <script is:inline type="application/json" id="items-data" set:html={JSON.stringify(DATA)}></script>
    <script is:inline>
      const ACCENTS = ['teal', 'green', 'persimmon', 'indigo'];
      document.querySelector('.accent-toggle').addEventListener('click', () => {
        const de = document.documentElement, next = ACCENTS[(ACCENTS.indexOf(de.dataset.accent || 'teal') + 1) % ACCENTS.length];
        de.dataset.accent = next; try { localStorage.setItem('accent', next); } catch (e) {}
      });
      document.querySelector('.theme-toggle').addEventListener('click', () => {
        const de = document.documentElement, t = de.dataset.theme === 'dark' ? 'light' : 'dark';
        de.dataset.theme = t; try { localStorage.setItem('theme', t); } catch (e) {}
        dispatchEvent(new CustomEvent('themechange', { detail: t }));
      });
    </script>
    <script>
      // click: the detail panel
      const DATA = JSON.parse(document.getElementById('items-data')!.textContent || '{}');
      document.querySelectorAll<HTMLButtonElement>('.item, .lab').forEach((b) => b.addEventListener('click', () => open(b.dataset.id!)));
      const dlg = document.getElementById('detail') as HTMLDialogElement;
      const $ = (id: string) => document.getElementById(id)!;
      const el = (tag: string, html: string) => { const e = document.createElement(tag); e.innerHTML = html; return e; };
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
      function open(id: string) {
        const it = DATA[id]; if (!it) return;
        const img = $('d-img') as HTMLImageElement;
        img.hidden = !it.thumb; if (it.thumb) img.src = it.thumb;
        $('d-sub').textContent = it.sub; $('d-title').textContent = it.title; $('d-text').textContent = it.text;
        const days = $('d-days'); days.replaceChildren(...(it.days || []).map((d: any) =>
          el('li', `<span>${esc(d.date)}</span><b>${esc(d.day)}</b><a href="${esc(d.href)}" target="_blank" rel="noopener">${esc(d.title)} ↗</a>`)));
        const links = $('d-links'); links.replaceChildren(...[...(it.links || []), ...(it.pubs || [])].map((l: any) =>
          el('li', `<a href="${esc(l.href)}" target="_blank" rel="noopener">${esc(l.title)} ↗</a>`)));
        const act = $('d-actions'); act.replaceChildren();
        if (it.play) act.append(el('span', `<a class="btn primary" href="${esc(it.play)}">Play →</a>`).firstChild!);
        if (it.page) act.append(el('span', `<a class="btn" href="${esc(it.page)}">${id === 'research' ? 'All publications' : 'Project page'} →</a>`).firstChild!);
        dlg.showModal();
      }
      dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });   // click outside the panel

      // phones: the tabs jump between the swiping columns, and follow them
      const cols = document.querySelector('.cols') as HTMLElement, tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs button')];
      tabs.forEach((t, i) => t.addEventListener('click', () => cols.scrollTo({ left: i * cols.clientWidth, behavior: 'smooth' })));
      const mark = () => { const i = Math.round(cols.scrollLeft / Math.max(1, cols.clientWidth)); tabs.forEach((t, k) => t.classList.toggle('on', k === i)); };
      cols.addEventListener('scroll', mark, { passive: true }); mark();

      // the SimReady Leaves card: its leaves fall, after first paint
      const leaves = () => import('../scripts/leaves.js');
      if ('requestIdleCallback' in window) requestIdleCallback(leaves, { timeout: 1200 }); else setTimeout(leaves, 200);

    </script>
  </body>
</html>
